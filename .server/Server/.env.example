PORT=3001
NODE_ENV=development
CORS_ORIGIN=*
JSON_BODY_LIMIT=2mb
RAW_BODY_LIMIT_BYTES=52428800
STORAGE_ROOT=./storage
STORAGE_LIMIT_BYTES=5368709120

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=zhixu

JWT_SECRET=dev_secret_change_me
JWT_ACCESS_TTL=30d
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# Admin panel (requires email login + matching ADMIN_EMAIL)
ADMIN_EMAIL=

# SMTP (required for registration + email login/verification codes)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TLS_REJECT_UNAUTHORIZED=true
